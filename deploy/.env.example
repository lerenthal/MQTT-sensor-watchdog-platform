# =============================================================================
# PsygaBio Device Watchdog - production secrets
#
# COPY TO deploy/.env AND EDIT. Then:  chmod 600 deploy/.env
#
# This file is in .gitignore. It holds the MQTT password, the Telegram bot
# token and the Flask session key - never commit it, never paste it into
# a ticket, and never let it end up in a shell history.
# =============================================================================

# The MQTT broker. The default is the production host itself.
WATCHDOG_MQTT_BROKER=10.10.17.11

# The port the watchdog serves on. The wall board lives here.
WATCHDOG_PORT=5050

# The address to bind. 0.0.0.0 makes the wall board reachable from the
# whole network. Set it to the host's LAN address to restrict it.
WATCHDOG_BIND=0.0.0.0

# MUST be unique on this host. Mosquitto allows one connection per
# client id and kicks the older session, so two instances sharing an id
# push each other off the broker in a reconnect loop.
WATCHDOG_INSTANCE_ID=psygabio-prod

# The timezone every timestamp is recorded in. Local wall-clock, so the
# audit trail lines up with the device timeline and the operator's clock.
TZ=Asia/Jerusalem

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# The MQTT password. The same one the devices and telegraf use.
WATCHDOG_MQTT_PASSWORD=CHANGE_ME

# The Telegram bot token, from @BotFather. Leave empty to disable paging.
WATCHDOG_TG_TOKEN=

# The Telegram chat id to page. Leave empty to disable paging.
WATCHDOG_TG_CHAT_ID=

# The Flask session key. Leave empty and the app generates a strong one
# and persists it to the config on first start. If you set it here, use
# a long random value: a predictable session key lets anyone forge a
# login cookie.
WATCHDOG_SECRET_KEY=
