# Copy this file to .env and fill in real values. Anything you set here
# OVERRIDES the matching key in config.yaml for the values that matter
# most for security (broker password, Telegram bot token, chat id, Flask
# signing secret).
#
# Lines that start with # are ignored.
# Stop using a real secret? Remove the line entirely — falling back to
# config.yaml is the supported behavior.

# MQTT broker (your facility broker at 10.10.17.11)
# WATCHDOG_MQTT_BROKER=10.10.17.11
# WATCHDOG_MQTT_PORT=1883
# WATCHDOG_MQTT_USERNAME=yaniv
# WATCHDOG_MQTT_PASSWORD=

# Telegram bot (from @BotFather)
# WATCHDOG_TG_TOKEN=
# WATCHDOG_TG_CHAT_ID=
# WATCHDOG_TG_ENABLED=true

# Flask session-signing secret — any random long string. Rotate to
# invalidate existing browser sessions.
# WATCHDOG_SECRET_KEY=replace-this-with-something-random

# Friendly name printed on the report header.
# WATCHDOG_FACILITY_NAME=Mushroom Cultivation Facility

# Timezone for log timestamps & report generation. Anything `timedatectl
# list-timezones` accepts.
TZ=Asia/Jerusalem
